{
  // Explicit IntelliSense configuration for the Zephyr west workspace.
  // compile_commands.json is generated by the build; build the application once first.
  "configurations": [
    {
      "name": "Zephyr ESP32-S3",
      "compileCommands": "${workspaceFolder}/build/zero_blink/compile_commands.json",
      "compilerPath": "${env:HOME}/zephyr-sdk-1.0.1/gnu/xtensa-espressif_esp32s3_zephyr-elf/bin/xtensa-espressif_esp32s3_zephyr-elf-gcc",
      "intelliSenseMode": "linux-gcc-x86",
      "cStandard": "c17",
      "cppStandard": "c++17"
    }
  ],
  "version": 4
}
